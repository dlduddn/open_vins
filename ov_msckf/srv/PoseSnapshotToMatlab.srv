# Request: C++ OpenVINS node -> MATLAB
# The pose/covariance are for the t_k IMU clone after OpenVINS visual updates.
# pose_covariance_row_major is ordered as [position_error(3), orientation_error(3)].
float64 timestamp_cam
float64 timestamp_imu
float64[3] position
float64[4] quaternion
float64[36] pose_covariance_row_major

---

# Response: MATLAB -> C++
# EKF residual r, Jacobian H, and measurement noise R.
# H columns must match the request covariance order:
# [position_error(3), orientation_error(3)] for the t_k clone.
bool accepted
string status_message
float64[] residual
uint32 jacobian_rows
uint32 jacobian_cols
float64[] jacobian_row_major
uint32 measurement_cov_rows
uint32 measurement_cov_cols
float64[] measurement_cov_row_major
